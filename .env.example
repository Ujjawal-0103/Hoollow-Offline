# ==============================================================================
# HACKATHON ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the development environment:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
# DO NOT commit .env with real secrets to version control.
# ==============================================================================

# Backend API Configuration
PORT=3001
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Frontend Configuration (Exposed to browser via Next.js NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# Database Configuration (Docker Compose & Prisma)
# Note: Host port 5435 is used by default to prevent conflict with local PostgreSQL (5432) and other project containers (5434)
POSTGRES_USER=hackathon
POSTGRES_PASSWORD=localdev_only_change_me
POSTGRES_DB=hackathon
POSTGRES_PORT=5435

# Prisma Connection URL (Points to host port 5435 for local development)
DATABASE_URL=postgresql://hackathon:localdev_only_change_me@localhost:5435/hackathon?schema=public

# Optional External / AI Service Keys (Leave empty until required by problem statement)
# AI_API_KEY=your_key_here
# YOUTUBE_API_KEY=your_key_here
# ADMIN_API_KEY=admin_dev_secret

# Part 5: Industry Intelligence & Dynamic Roadmaps Configuration
INDUSTRY_MONITOR_ENABLED=true
INDUSTRY_SCAN_INTERVAL_MINUTES=360
INDUSTRY_AUTO_APPLY_LOW_RISK=false
INDUSTRY_AUTO_APPLY_MEDIUM_RISK=false
