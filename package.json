{
    "name": "hackathon-offline-prep",
    "version": "1.0.0",
    "private": true,
    "description": "Hoollow - AI-Powered Learning Platform",
    "packageManager": "npm@10.9.2",
    "scripts": {
        "dev": "npm run dev --workspace=api",
        "dev:api": "npm run dev --workspace=api",
        "dev:web": "npm run dev --workspace=web",
        "build": "npm run build --workspace=api",
        "build:api": "npm run build --workspace=api",
        "build:web": "npm run build --workspace=web",
        "start": "npm run start --workspace=api",
        "start:api": "npm run start --workspace=api",
        "typecheck": "npm run typecheck --workspace=api",
        "typecheck:api": "npm run typecheck --workspace=api",
        "test": "npm run test --workspace=api",
        "test:api": "npm run test --workspace=api",
        "prisma:generate": "npm run prisma:generate --workspace=api",
        "preflight": "powershell -ExecutionPolicy Bypass -File ./scripts/preflight.ps1",
        "preflight:bash": "bash ./scripts/preflight.sh",
        "db:up": "docker compose up -d postgres",
        "db:down": "docker compose stop postgres",
        "db:logs": "docker compose logs -f postgres",
        "db:clean": "docker compose down -v"
    },
    "keywords": [
        "hackathon",
        "template",
        "preflight",
        "setup",
        "npm",
        "hoollow"
    ],
    "author": "",
    "license": "UNLICENSED",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "allowScripts": {
        "unrs-resolver@1.12.2": true,
        "@prisma/client@6.19.3": true,
        "prisma@6.19.3": true,
        "@prisma/engines@6.19.3": true,
        "esbuild@0.28.2": true
    }
}
