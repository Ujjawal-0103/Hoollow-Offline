// Hoollow Learning Platform - Prisma Database Schema
// Part 1: Backend Foundation (PostgreSQL Datasource & Client Setup)
// Part 2: Learner Profiles & Structured Roadmaps
// Part 3: In-App Learning & Progress Tracking
// Part 4: Quiz & Assessment System

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Learner {
  id                String           @id @default(uuid())
  displayName       String?
  preferredLanguage String           @default("English")
  currentLevel      String           // BEGINNER, INTERMEDIATE, ADVANCED
  learningGoal      String
  minutesPerDay     Int              @default(30)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  roadmaps          Roadmap[]
  lessonProgress    LessonProgress[]
  quizAttempts      QuizAttempt[]

  @@map("learners")
}

model Roadmap {
  id                       String      @id @default(uuid())
  learnerId                String
  title                    String
  skill                    String
  currentLevel             String
  goal                     String
  estimatedDurationMinutes Int
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  learner                  Learner     @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  milestones               Milestone[]

  @@index([learnerId])
  @@map("roadmaps")
}

model Milestone {
  id                       String    @id @default(uuid())
  roadmapId                String
  title                    String
  description              String?
  order                    Int
  estimatedDurationMinutes Int
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  roadmap                  Roadmap   @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  lessons                  Lesson[]

  @@unique([roadmapId, order])
  @@index([roadmapId])
  @@map("milestones")
}

model Lesson {
  id                 String           @id @default(uuid())
  milestoneId        String
  title              String
  description        String?
  order              Int
  durationMinutes    Int
  learningObjectives String[]
  content            String           @db.Text
  examples           String[]
  keyTakeaways       String[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  milestone          Milestone        @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  progress           LessonProgress[]
  quizzes            Quiz[]

  @@unique([milestoneId, order])
  @@index([milestoneId])
  @@map("lessons")
}

model LessonProgress {
  id          String    @id @default(uuid())
  learnerId   String
  lessonId    String
  completed   Boolean   @default(true)
  completedAt DateTime? @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  learner     Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([learnerId, lessonId])
  @@index([learnerId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model Quiz {
  id          String         @id @default(uuid())
  lessonId    String
  title       String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions   QuizQuestion[]
  attempts    QuizAttempt[]

  @@index([lessonId])
  @@map("quizzes")
}

model QuizQuestion {
  id            String         @id @default(uuid())
  quizId        String
  question      String         @db.Text
  options       String[]
  correctAnswer String
  explanation   String         @db.Text
  order         Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  quiz          Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  responses     QuizResponse[]

  @@unique([quizId, order])
  @@index([quizId])
  @@map("quiz_questions")
}

model QuizAttempt {
  id             String         @id @default(uuid())
  learnerId      String
  quizId         String
  score          Float          // percentage (0 to 100)
  totalQuestions Int
  correctAnswers Int
  submittedAt    DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  learner        Learner        @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  quiz           Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  responses      QuizResponse[]

  @@index([learnerId])
  @@index([quizId])
  @@map("quiz_attempts")
}

model QuizResponse {
  id             String       @id @default(uuid())
  attemptId      String
  questionId     String
  selectedAnswer String
  isCorrect      Boolean
  createdAt      DateTime     @default(now())

  attempt        QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@map("quiz_responses")
}
