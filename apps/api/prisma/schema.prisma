// Hoollow Learning Platform - Prisma Database Schema
// Part 1: Backend Foundation (PostgreSQL Datasource & Client Setup)
// Part 2: Learner Profiles & Structured Roadmaps
// Part 3: In-App Learning & Progress Tracking
// Part 4: Quiz & Assessment System
// Part 5: Industry Intelligence, Dynamic Roadmaps & Personalized Learning

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Learner {
  id                String           @id @default(uuid())
  displayName       String?
  preferredLanguage String           @default("English")
  currentLevel      String           // BEGINNER, INTERMEDIATE, ADVANCED
  learningGoal      String
  minutesPerDay     Int              @default(30)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  roadmaps          Roadmap[]
  lessonProgress    LessonProgress[]
  quizAttempts      QuizAttempt[]
  notifications     Notification[]

  @@map("learners")
}

model Roadmap {
  id                       String           @id @default(uuid())
  learnerId                String
  title                    String
  skill                    String
  currentLevel             String
  goal                     String
  estimatedDurationMinutes Int
  version                  Int              @default(1)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  learner                  Learner          @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  milestones               Milestone[]
  versions                 RoadmapVersion[]
  updates                  RoadmapUpdate[]

  @@index([learnerId])
  @@map("roadmaps")
}

model Milestone {
  id                       String    @id @default(uuid())
  roadmapId                String
  title                    String
  description              String?
  order                    Int
  estimatedDurationMinutes Int
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  roadmap                  Roadmap   @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  lessons                  Lesson[]

  @@unique([roadmapId, order])
  @@index([roadmapId])
  @@map("milestones")
}

model Lesson {
  id                 String                   @id @default(uuid())
  milestoneId        String
  title              String
  description        String?
  order              Int
  durationMinutes    Int
  learningObjectives String[]
  content            String                   @db.Text
  examples           String[]
  keyTakeaways       String[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  milestone          Milestone                @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  progress           LessonProgress[]
  quizzes            Quiz[]
  skills             LessonSkill[]
  recommendations    ResourceRecommendation[]

  @@unique([milestoneId, order])
  @@index([milestoneId])
  @@map("lessons")
}

model LessonProgress {
  id          String    @id @default(uuid())
  learnerId   String
  lessonId    String
  completed   Boolean   @default(true)
  completedAt DateTime? @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  learner     Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([learnerId, lessonId])
  @@index([learnerId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model Quiz {
  id          String         @id @default(uuid())
  lessonId    String
  title       String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions   QuizQuestion[]
  attempts    QuizAttempt[]

  @@index([lessonId])
  @@map("quizzes")
}

model QuizQuestion {
  id            String         @id @default(uuid())
  quizId        String
  question      String         @db.Text
  options       String[]
  correctAnswer String
  explanation   String         @db.Text
  order         Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  quiz          Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  responses     QuizResponse[]

  @@unique([quizId, order])
  @@index([quizId])
  @@map("quiz_questions")
}

model QuizAttempt {
  id             String         @id @default(uuid())
  learnerId      String
  quizId         String
  score          Float          // percentage (0 to 100)
  totalQuestions Int
  correctAnswers Int
  submittedAt    DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  learner        Learner        @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  quiz           Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  responses      QuizResponse[]

  @@index([learnerId])
  @@index([quizId])
  @@index([submittedAt])
  @@map("quiz_attempts")
}

model QuizResponse {
  id             String       @id @default(uuid())
  attemptId      String
  questionId     String
  selectedAnswer String
  isCorrect      Boolean
  createdAt      DateTime     @default(now())

  attempt        QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@map("quiz_responses")
}

// ==============================================================================
// PART 5: INDUSTRY INTELLIGENCE & DYNAMIC ROADMAP MODELS
// ==============================================================================

model IndustrySource {
  id                     String          @id @default(uuid())
  name                   String
  type                   String          // RSS, OFFICIAL_RELEASE, DOCS_UPDATE, PUBLIC_API
  url                    String
  technologies           String[]
  isActive               Boolean         @default(true)
  pollingIntervalMinutes Int             @default(360)
  lastSuccessfulCheck    DateTime?
  lastAttemptedCheck     DateTime?
  errorState             String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  events                 IndustryEvent[]

  @@map("industry_sources")
}

model Skill {
  id          String               @id @default(uuid())
  name        String
  slug        String               @unique
  category    String
  description String?
  aliases     String[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  lessons     LessonSkill[]
  events      IndustryEventSkill[]

  @@map("skills")
}

model IndustryEvent {
  id              String               @id @default(uuid())
  sourceId        String
  externalId      String?
  canonicalUrl    String
  title           String
  summary         String?              @db.Text
  content         String?              @db.Text
  sourceName      String
  publishedAt     DateTime
  detectedAt      DateTime             @default(now())
  contentHash     String
  changeType      String?              // NEW_FEATURE, BREAKING_CHANGE, RECOMMENDED_PRACTICE, SECURITY_ADVISORY, DEPRECATION, MINOR_UPDATE, IRRELEVANT
  importance      String?              // LOW, MEDIUM, HIGH, CRITICAL
  confidence      Float?               // 0.0 to 1.0
  analysisStatus  String               @default("PENDING") // PENDING, PROCESSING, ANALYZED, NO_ACTION, FAILED
  analysisResult  Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  source          IndustrySource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  skills          IndustryEventSkill[]
  roadmapUpdates  RoadmapUpdate[]
  roadmapVersions RoadmapVersion[]

  @@unique([sourceId, externalId])
  @@index([sourceId])
  @@index([canonicalUrl])
  @@index([contentHash])
  @@index([analysisStatus])
  @@map("industry_events")
}

model IndustryEventSkill {
  id        String        @id @default(uuid())
  eventId   String
  skillId   String

  event     IndustryEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  skill     Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([eventId, skillId])
  @@index([eventId])
  @@index([skillId])
  @@map("industry_event_skills")
}

model LessonSkill {
  id        String   @id @default(uuid())
  lessonId  String
  skillId   String

  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([lessonId, skillId])
  @@index([lessonId])
  @@index([skillId])
  @@map("lesson_skills")
}

model RoadmapVersion {
  id                String         @id @default(uuid())
  roadmapId         String
  versionNumber     Int
  changeSummary     String         @db.Text
  changeReason      String         @db.Text
  triggeringEventId String?
  snapshot          Json
  publishedAt       DateTime       @default(now())
  createdAt         DateTime       @default(now())

  roadmap           Roadmap        @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  triggeringEvent   IndustryEvent? @relation(fields: [triggeringEventId], references: [id], onDelete: SetNull)

  @@unique([roadmapId, versionNumber])
  @@index([roadmapId])
  @@index([triggeringEventId])
  @@map("roadmap_versions")
}

model RoadmapUpdate {
  id                 String         @id @default(uuid())
  roadmapId          String
  industryEventId    String
  proposedChanges    Json
  rationale          String         @db.Text
  evidenceReferences String[]
  impactScore        Float
  riskLevel          String         // LOW, MEDIUM, HIGH
  approvalStatus     String         @default("PROPOSED") // PROPOSED, APPROVED, REJECTED, APPLIED, FAILED
  createdAt          DateTime       @default(now())
  reviewedAt         DateTime?
  appliedAt          DateTime?

  roadmap            Roadmap        @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  industryEvent      IndustryEvent  @relation(fields: [industryEventId], references: [id], onDelete: Cascade)
  notifications      Notification[]

  @@unique([roadmapId, industryEventId])
  @@index([roadmapId])
  @@index([industryEventId])
  @@index([approvalStatus])
  @@map("roadmap_updates")
}

model Notification {
  id              String         @id @default(uuid())
  learnerId       String
  roadmapUpdateId String?
  title           String
  message         String         @db.Text
  reason          String         @db.Text
  read            Boolean        @default(false)
  actionUrl       String?
  createdAt       DateTime       @default(now())

  learner         Learner        @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  roadmapUpdate   RoadmapUpdate? @relation(fields: [roadmapUpdateId], references: [id], onDelete: SetNull)

  @@index([learnerId, read])
  @@index([learnerId])
  @@map("notifications")
}

model ResourceRecommendation {
  id              String   @id @default(uuid())
  lessonId        String
  title           String
  url             String
  provider        String   @default("YOUTUBE")
  durationSeconds Int?
  channelTitle    String?
  language        String   @default("English")
  relevanceScore  Float    @default(1.0)
  createdAt       DateTime @default(now())

  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("resource_recommendations")
}
