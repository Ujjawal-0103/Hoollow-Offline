# ==============================================================================
# Hoollow Backend API - Environment Configuration
# ==============================================================================

# Server Port (Default: 5000)
PORT=5000

# Runtime Environment (development | production | test)
NODE_ENV=development

# Allowed Frontend URL for CORS (e.g. Next.js Web App)
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example for Docker Compose setup:
# DATABASE_URL=postgresql://hackathon:localdev_only_change_me@localhost:5435/hackathon?schema=public
DATABASE_URL=
